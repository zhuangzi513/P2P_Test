/* ===== 页面整体 ===== */
page {
  background-color: #E4FFED;
  min-height: 100vh;
}

.sale-page {
  padding: 40rpx 30rpx;
  min-height: 100vh;
}

/* ===== 头部 ===== */
.sale-header {
  text-align: center;
  margin-bottom: 50rpx;
  padding-top: 20rpx;
}

.sale-title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #047504;
  letter-spacing: 4rpx;
  text-shadow: 4rpx 4rpx 6rpx rgba(0, 255, 0, 0.3);
}

.sale-subtitle {
  display: block;
  font-size: 24rpx;
  color: #026302;
  margin-top: 12rpx;
  opacity: 0.7;
}

/* ===== 卡片网格布局 ===== */
.cards-container {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-start;
  gap: 16rpx;
  padding: 0 6rpx;
}

/* ===== 单张卡片 ===== */
.banker-card {
  width: calc((100% - 32rpx) / 3);
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx 12rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  overflow: hidden;
  border: 2rpx solid rgba(0, 115, 0, 0.1);
  box-shadow: 0 6rpx 20rpx rgba(0, 115, 0, 0.1);
  transition: all 0.35s ease;
}

.banker-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, rgba(0, 115, 0, 0.04) 0%, transparent 50%);
  border-radius: 24rpx;
  pointer-events: none;
}

.banker-card.top-rated {
  border-color: rgba(255, 215, 0, 0.5);
  box-shadow: 0 8rpx 40rpx rgba(0, 115, 0, 0.18);
}

.banker-card.top-rated::before {
  background: linear-gradient(135deg, rgba(255, 215, 0, 0.08) 0%, transparent 50%);
}

.card-hover {
  transform: translateY(-6rpx) scale(1.02);
  box-shadow: 0 16rpx 48rpx rgba(0, 115, 0, 0.2);
  border-color: rgba(0, 115, 0, 0.3);
}

/* ===== CD 光盘效果 ===== */
.cd-disc {
  width: 120rpx;
  height: 120rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.cd-ring {
  position: absolute;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: conic-gradient(
    from 0deg,
    rgba(2, 99, 2, 0.08) 0deg,
    rgba(2, 99, 2, 0.25) 45deg,
    rgba(4, 117, 4, 0.18) 90deg,
    rgba(2, 99, 2, 0.08) 135deg,
    rgba(2, 99, 2, 0.25) 180deg,
    rgba(4, 117, 4, 0.18) 225deg,
    rgba(2, 99, 2, 0.08) 270deg,
    rgba(2, 99, 2, 0.25) 315deg,
    rgba(2, 99, 2, 0.08) 360deg
  );
  border: 4rpx solid rgba(0, 115, 0, 0.12);
  box-shadow:
    0 0 30rpx rgba(0, 115, 0, 0.1),
    inset 0 0 20rpx rgba(0, 115, 0, 0.04);
}

.cd-inner {
  width: 70rpx;
  height: 70rpx;
  border-radius: 50%;
  overflow: hidden;
  border: 3rpx solid rgba(0, 115, 0, 0.2);
  z-index: 2;
  background: #E4FFED;
}

.banker-avatar {
  width: 100%;
  height: 100%;
  display: block;
}

.cd-shine {
  position: absolute;
  top: 4rpx;
  left: 12rpx;
  width: 28rpx;
  height: 56rpx;
  background: linear-gradient(
    180deg,
    rgba(255, 255, 255, 0.35) 0%,
    rgba(255, 255, 255, 0) 100%
  );
  border-radius: 50%;
  transform: rotate(-30deg);
  pointer-events: none;
  z-index: 3;
}

/* ===== 卡片信息 ===== */
.card-info {
  text-align: center;
  width: 100%;
}

.banker-nick {
  display: block;
  font-size: 24rpx;
  font-weight: bold;
  color: #026302;
  margin-bottom: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.banker-score-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}

.score-icon {
  font-size: 22rpx;
  color: #ffd700;
}

.banker-score {
  font-size: 22rpx;
  color: #E4393C;
  font-weight: bold;
}

.card-rank {
  margin-top: 8rpx;
  font-size: 18rpx;
  color: rgba(2, 99, 2, 0.35);
  letter-spacing: 2rpx;
}

/* ===== 加载状态 ===== */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
  gap: 20rpx;
}

.loading-text {
  font-size: 26rpx;
  color: #047504;
  opacity: 0.6;
}

/* ===== 空状态 ===== */
.empty-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
}

.empty-text {
  font-size: 28rpx;
  color: rgba(2, 99, 2, 0.4);
}
