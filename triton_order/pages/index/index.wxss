page {
  background-color: #E4FFED;
}


/* ===== 广告招租区域 ===== */
.ad-container {
  width: 100%;
  margin-bottom: 20rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.ad-swiper {
  width: 100%;
  height: 360rpx;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(0, 80, 0, 0.15);
}

.ad-item {
  width: 100%;
  height: 360rpx;
  position: relative;
}

.ad-item image {
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
}

.ad-item-info {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 24rpx;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.65));
  border-radius: 0 0 16rpx 16rpx;
}

.ad-item-name {
  font-size: 28rpx;
  color: #ffffff;
  font-weight: 600;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-bottom: 8rpx;
}

.ad-item-price {
  display: flex;
  align-items: baseline;
}

.ad-price-symbol {
  font-size: 26rpx;
  color: #FFD700;
  font-weight: bold;
  margin-right: 4rpx;
}

.ad-price-num {
  font-size: 36rpx;
  color: #FFD700;
  font-weight: bold;
  line-height: 1;
}

.ad-placeholder {
  width: 100%;
  height: 360rpx;
  background: #C8E6C9;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 80, 0, 0.12);
}

.ad-placeholder-icon {
  font-size: 72rpx;
  margin-bottom: 16rpx;
}

.ad-placeholder-text {
  font-size: 30rpx;
  color: #026302;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.ad-placeholder-desc {
  font-size: 24rpx;
  color: #047504;
  opacity: 0.7;
}

/* 广告招租联系页面（最后一张轮播） */
.ad-contact {
  width: 100%;
  height: 360rpx;
  background: linear-gradient(135deg, #026302 0%, #047504 50%, #059505 100%);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ad-contact-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx;
}

.ad-contact-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 16rpx;
  letter-spacing: 4rpx;
}

.ad-contact-icon {
  font-size: 60rpx;
  margin-bottom: 12rpx;
}

.ad-contact-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 24rpx;
}

.ad-contact-divider {
  width: 160rpx;
  height: 2rpx;
  background: rgba(255, 255, 255, 0.3);
  margin-bottom: 24rpx;
}

.ad-contact-phone {
  font-size: 28rpx;
  font-weight: 600;
  color: #FFD700;
  margin-bottom: 10rpx;
  letter-spacing: 2rpx;
}

.ad-contact-tip {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.6);
}


.jd-category-container {
  background: #C8E6C9;
  padding: 28rpx 16rpx 20rpx;
  margin: 0 24rpx 20rpx;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 80, 0, 0.18), 0 2rpx 8rpx rgba(0, 60, 0, 0.1);
}

.jd-category-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-start;
  gap: 20rpx;
}

.jd-category-item {
  width: calc((100% - 40rpx) / 3);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 28rpx 12rpx 24rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  margin-bottom: 0;
  box-shadow: 0 4rpx 16rpx rgba(0, 115, 0, 0.08);
}

.jd-category-icon-wrap {
  width: 110rpx;
  height: 110rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
  border-radius: 50%;
  background: #E4FFED;
  box-shadow: 0 2rpx 8rpx rgba(0, 115, 0, 0.1);
  transition: all 0.3s ease;
  overflow: hidden;
}

.jd-category-icon-wrap image {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
}

.jd-category-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #026302;
  text-align: center;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-bottom: 8rpx;
}

.jd-category-level {
  font-size: 22rpx;
  color: #047504;
  background: #E4FFED;
  padding: 4rpx 20rpx;
  border-radius: 20rpx;
  text-align: center;
}

/* "更多" 按钮 */
.jd-category-more {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: rgba(2, 99, 2, 0.08);
  flex-shrink: 0;
}

.jd-category-more-icon {
  font-size: 24rpx;
  color: #026302;
}



.jd-main-container {
  min-height: 100vh;
  padding-bottom: 40rpx;
}



.jd-section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 24rpx 28rpx;
}

.jd-section-header--center {
  justify-content: center;
  padding: 32rpx 24rpx 20rpx;
}

.jd-section-title {
  display: flex;
  align-items: center;
}

.jd-section-title--center {
  justify-content: center;
}

.jd-section-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #047504;
  position: relative;
}



.jd-section-divider {
  height: 2rpx;
  background: #026302;
  margin: 0 24rpx 20rpx;
}

.jd-section-more {
  font-size: 26rpx;
  color: #047504;
  display: flex;
  align-items: center;
}


.jd-price-symbol {
  font-size: 32rpx;
  color: #E4393C;
  font-weight: bold;
  margin-right: 4rpx;
}

.jd-price-num {
  font-size: 48rpx;
  color: #E4393C;
  font-weight: bold;
  line-height: 1;
}

.jd-goods-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  padding: 0 24rpx 20rpx;
  gap: 20rpx;
}

.jd-goods-card {
  width: calc(50% - 15rpx);
  background: #FFFFFF;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 16rpx rgba(7, 255, 11, 0.3);
  transition: all 0.3s ease;
}

.jd-goods-img-wrap {
  width: 100%;
  height: 345rpx;
  position: relative;
  overflow: hidden;
  background: #a4bea6;
}

.jd-goods-img-wrap image {
  width: 100%;
  height: 100%;
  display: block;
}

.jd-goods-info {
  padding: 16rpx;
}

.jd-goods-name {
  font-size: 28rpx;
  border: #005000;
  color: #005000;
  font-weight: bold;
  line-height: 1.4;
  height: 78rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  margin-bottom: 8rpx;
}

.jd-goods-desc {
  font-size: 24rpx;
  color: #999;
  line-height: 1.3;
  height: 31rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-bottom: 12rpx;
}

.jd-goods-price-box {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.jd-goods-price {
  display: flex;
  align-items: baseline;
  color: #022c12;
}

.jd-goods-price .jd-price-symbol {
  font-size: 36rpx;
}

.jd-goods-price .jd-price-num {
  font-size: 36rpx;
  color: #086008;
}



::-webkit-scrollbar {
  width: 0;
  height: 0;
  color: transparent;
}

