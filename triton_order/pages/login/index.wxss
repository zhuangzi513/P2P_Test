page {
  background: rgb(236, 236, 236);
}
.box {
  margin: 32rpx;
  background: #fff;
  border-radius: 24rpx;
  padding-bottom: 64rpx;
}
.title {
  padding: 88rpx 0 56rpx 0;
  text-align: center;
}
.login-btn {
  background: linear-gradient(135deg, #E4393C 0%, #C81623 100%);
  color: #fff;
  padding: 28rpx 88rpx;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(228, 57, 60, 0.3);
}
