page {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

.page-container {
  min-height: 100vh;
  position: relative;
  overflow: hidden;
}

/* 背景装饰 */
.bg-decoration {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
}

.circle {
  position: absolute;
  border-radius: 50%;
  opacity: 0.1;
  background: #fff;
}

.circle-1 {
  width: 400rpx;
  height: 400rpx;
  top: -100rpx;
  right: -100rpx;
}

.circle-2 {
  width: 300rpx;
  height: 300rpx;
  bottom: 20%;
  left: -150rpx;
}

.circle-3 {
  width: 200rpx;
  height: 200rpx;
  bottom: -50rpx;
  right: 50rpx;
}

/* 内容区 */
.content-area {
  position: relative;
  z-index: 1;
  padding: 120rpx 48rpx 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* Logo 区域 */
.logo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 80rpx;
}

.logo-wrapper {
  width: 160rpx;
  height: 160rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.15);
}

.logo-icon {
  font-size: 80rpx;
}

.app-name {
  font-size: 48rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 2rpx;
  margin-bottom: 16rpx;
}

.app-tagline {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  letter-spacing: 1rpx;
}

/* 登录卡片 */
.login-card {
  width: 100%;
  background: #fff;
  border-radius: 32rpx;
  padding: 48rpx 40rpx;
  box-shadow: 0 24rpx 64rpx rgba(0, 0, 0, 0.15);
}

.card-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  text-align: center;
  margin-bottom: 40rpx;
}

/* 角色选项 */
.role-option {
  display: flex;
  align-items: center;
  padding: 32rpx;
  background: #f8f9fa;
  border-radius: 20rpx;
  transition: all 0.3s ease;
}

.role-option:active {
  transform: scale(0.98);
  background: #f0f1f2;
}

.role-option.banker {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.role-option.banker:active {
  background: linear-gradient(135deg, #5a6fd6 0%, #6a4190 100%);
}

.role-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  margin-right: 28rpx;
}

.customer-icon {
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
}

.banker-icon {
  background: rgba(255, 255, 255, 0.2);
}

.role-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.role-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.role-option.banker .role-title {
  color: #fff;
}

.role-desc {
  font-size: 24rpx;
  color: #999;
}

.role-option.banker .role-desc {
  color: rgba(255, 255, 255, 0.7);
}

.role-arrow {
  font-size: 48rpx;
  color: #ccc;
  font-weight: 300;
}

.role-option.banker .role-arrow {
  color: rgba(255, 255, 255, 0.5);
}

/* 分隔线 */
.divider {
  display: flex;
  align-items: center;
  margin: 32rpx 0;
}

.divider-line {
  flex: 1;
  height: 1rpx;
  background: #eee;
}

.divider-text {
  font-size: 24rpx;
  color: #999;
  padding: 0 24rpx;
  letter-spacing: 2rpx;
}

/* 底部提示 */
.footer-tips {
  margin-top: 48rpx;
  text-align: center;
}

.tip-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.6);
}