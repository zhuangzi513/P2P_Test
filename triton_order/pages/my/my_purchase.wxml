<view class="jd-main-container">
  <view class="jd-section-header">
    <view class="jd-section-title">
      <text class="jd-section-name">我的购买</text>
    </view>
  </view>

  <!-- 筛选 Tab -->
  <view class="tab-bar">
    <view class="tab-item {{activeTab === 'paid' ? 'tab-active' : ''}}" bindtap="switchTab" data-tab="paid">已付款</view>
    <view class="tab-item {{activeTab === 'shipped' ? 'tab-active' : ''}}" bindtap="switchTab" data-tab="shipped">待确认</view>
    <view class="tab-item {{activeTab === 'done' ? 'tab-active' : ''}}" bindtap="switchTab" data-tab="done">已完成</view>
  </view>

  <!-- 空状态 -->
  <van-empty wx:if="{{orders.length === 0 && !loading}}" description="暂无订单" />

  <!-- 商品卡片列表 -->
  <view class="jd-goods-grid" wx:if="{{orders.length > 0}}">
    <view class="jd-goods-card" wx:for="{{orders}}" wx:key="order_id" bindtap="onOrderTap" data-item="{{item}}">
      <view class="jd-goods-img-wrap">
        <image src="{{item._goodsInfo.thumbnail || '/images/default-goods.png'}}" mode="aspectFill" lazy-load="true" />
      </view>
      <view class="jd-goods-info">
        <view class="jd-goods-name">{{item._goodsInfo.name || '未知商品'}}</view>
        <view class="jd-goods-price-box">
          <view class="jd-goods-price">
            <text class="jd-price-symbol">¥</text>
            <text class="jd-price-num">{{item._goodsInfo.price || '--'}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <van-divider wx:if="{{orders.length > 0}}" custom-class="jd-end-divider" contentPosition="center">没有更多了</van-divider>
</view>
