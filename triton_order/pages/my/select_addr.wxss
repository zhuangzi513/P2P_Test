/* 原有样式保持不变 */
.address-container {
  min-height: 100vh;
  background-color: #f8f8f8;
  padding-bottom: 120rpx;
}

.address-list {
  padding: 20rpx 30rpx;
}

.address-item {
  background-color: #fff;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.address-content {
  padding: 30rpx;
}

.address-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.user-info {
  display: flex;
  align-items: baseline;
  gap: 20rpx;
}

.user-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #323233;
}

.user-phone {
  font-size: 28rpx;
  color: #969799;
}

.default-tag {
  background-color: #1989fa;
  color: #fff;
  font-size: 22rpx;
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
}

.address-detail {
  font-size: 28rpx;
  color: #646566;
  line-height: 1.5;
}

.address-actions {
  display: flex;
  border-top: 1rpx solid #ebedf0;
  padding: 20rpx 0;
}

.action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  font-size: 28rpx;
  color: #646566;
}

.action-divider {
  width: 1rpx;
  background-color: #ebedf0;
}

.safe-bottom-box {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx 40rpx;
  background-color: #f8f8f8;
}

.add-btn {
  background: linear-gradient(135deg, #1989fa, #0a62c9);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 88rpx;
  border-radius: 44rpx;
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
  box-shadow: 0 4rpx 12rpx rgba(25, 137, 250, 0.3);
}
