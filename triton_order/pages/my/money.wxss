page {
  background: #E4FFED;
}

.page-container {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 月份选择器 */
.month-filter {
  padding: 24rpx 32rpx 0;
}

.month-picker {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 115, 0, 0.06);
}

.month-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #026302;
}

.month-arrow {
  font-size: 20rpx;
  color: #047504;
  margin-left: 12rpx;
}

/* 汇总卡片 - 通用 */
.summary-section {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 32rpx;
}

.summary-card {
  flex: 1;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.summary-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
  display: block;
  margin-bottom: 8rpx;
}

.summary-amount {
  display: flex;
  align-items: baseline;
}

.summary-symbol {
  font-size: 28rpx;
  color: #fff;
  font-weight: bold;
  margin-right: 4rpx;
}

.summary-num {
  font-size: 38rpx;
  color: #fff;
  font-weight: bold;
  line-height: 1;
}

/* 玩家汇总 */
.summary-card.income {
  background: linear-gradient(135deg, #026302 0%, #047504 100%);
}

.summary-card.paid {
  background: linear-gradient(135deg, #E4393C 0%, #CC0000 100%);
}

/* 寄售商家汇总 */
.summary-card.banker-amount {
  background: linear-gradient(135deg, #1565C0 0%, #1976D2 100%);
}

.summary-card.banker-fee {
  background: linear-gradient(135deg, #FF6F00 0%, #E65100 100%);
}

/* 账单列表 */
.bill-list {
  margin: 0 32rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 115, 0, 0.08);
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #026302;
  padding: 28rpx 32rpx;
  background: #E4FFED;
  border-bottom: 1rpx solid #d4f0d4;
}

.bill-item {
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #e8f5e8;
}

.bill-item:last-child {
  border-bottom: none;
}

.bill-info {
  margin-bottom: 18rpx;
}

.bill-name-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 6rpx;
}

.bill-name {
  font-size: 28rpx;
  color: #026302;
  font-weight: 600;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.bill-tag {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
}

/* 玩家标签 */
.tag-income {
  background: #E4FFED;
  color: #026302;
}

.tag-paid {
  background: #FFF0F0;
  color: #E4393C;
}

/* 寄售商家标签 */
.tag-buy {
  background: #E3F2FD;
  color: #1565C0;
}

.tag-in {
  background: #FFF3E0;
  color: #E65100;
}

.bill-date {
  font-size: 22rpx;
  color: #999;
}

.bill-detail {
  background: #F8F8F8;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
}

.bill-detail-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 6rpx 0;
}

.bill-detail-row.actual {
  margin-top: 8rpx;
  padding-top: 12rpx;
  border-top: 1rpx dashed #ddd;
}

.detail-label {
  font-size: 24rpx;
  color: #666;
}

.detail-value {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

.detail-value.fee {
  color: #E4393C;
}

.detail-value.id-val {
  font-family: monospace;
  color: #555;
  font-size: 24rpx;
}

.detail-value.actual-amount {
  font-size: 28rpx;
  font-weight: 700;
}

.actual-amount.income {
  color: #026302;
}

.actual-amount.paid {
  color: #E4393C;
}

/* 空状态 */
.empty-tip {
  padding: 80rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #999;
}

/* 加载中 */
.loading-wrap {
  padding: 60rpx 0;
  text-align: center;
}

.loading-text {
  font-size: 26rpx;
  color: #999;
}
