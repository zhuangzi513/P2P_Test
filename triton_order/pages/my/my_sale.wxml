<view class="page-container">
  <!-- 标题 -->
  <view class="section-header">
    <view class="section-title">
      <text class="section-name">我的寄售</text>
    </view>
  </view>

  <!-- 筛选 Tab -->
  <view class="tab-bar">
    <view class="tab-item {{activeTab === 'onsale' ? 'tab-active' : ''}}" bindtap="switchTab" data-tab="onsale">寄售中</view>
    <view class="tab-item {{activeTab === 'shipping' ? 'tab-active' : ''}}" bindtap="switchTab" data-tab="shipping">待发快递</view>
    <view class="tab-item {{activeTab === 'pending' ? 'tab-active' : ''}}" bindtap="switchTab" data-tab="pending">待结算</view>
    <view class="tab-item {{activeTab === 'done' ? 'tab-active' : ''}}" bindtap="switchTab" data-tab="done">已完成</view>
  </view>

  <!-- 空状态 -->
  <van-empty wx:if="{{orders.length === 0 && !loading}}" description="暂无订单" />

  <!-- ==================== 寄售中列表 ==================== -->
  <block wx:if="{{orders.length > 0 && activeTab === 'onsale'}}">
    <view class="order-list">
      <view class="order-card" wx:for="{{orders}}" wx:key="order_id" bindtap="onOrderTap" data-item="{{item}}">
        <view class="card-left">
          <image class="card-thumb" src="/images/default-goods.png" mode="aspectFill" />
        </view>
        <view class="card-center">
          <view class="card-row">
            <text class="card-label">订单号</text>
            <text class="card-value id-value">{{item.order_id}}</text>
          </view>
          <view class="card-row">
            <text class="card-label">商品编号</text>
            <text class="card-value id-value">{{item.goods_id}}</text>
          </view>
          <view class="card-row">
            <text class="card-label">期望售价</text>
            <text class="card-value price-value">¥{{item.goods_price_str}}</text>
          </view>
        </view>
        <view class="card-right">
          <view class="btn-lower" catchtap="onLowerPrice" data-item="{{item}}">降价</view>
        </view>
      </view>
    </view>
    <van-divider wx:if="{{orders.length > 0}}" contentPosition="center">没有更多了</van-divider>
  </block>

  <!-- ==================== 待发快递列表 ==================== -->
  <block wx:if="{{orders.length > 0 && activeTab === 'shipping'}}">
    <view class="order-list">
      <view class="order-card shipping-card" wx:for="{{orders}}" wx:key="order_id" bindtap="onOrderTap" data-item="{{item}}">
        <view class="card-left">
          <image class="card-thumb" src="/images/default-goods.png" mode="aspectFill" />
        </view>
        <view class="card-center">
          <view class="card-row">
            <text class="card-label">订单号</text>
            <text class="card-value id-value">{{item.order_id}}</text>
          </view>
          <view class="card-row">
            <text class="card-label">商品编号</text>
            <text class="card-value id-value">{{item.goods_id}}</text>
          </view>
          <view class="card-row">
            <text class="card-label">期望售价</text>
            <text class="card-value price-value">¥{{item.goods_price_str}}</text>
          </view>
        </view>
      </view>
    </view>
    <van-divider wx:if="{{orders.length > 0}}" contentPosition="center">没有更多了</van-divider>
  </block>

  <!-- ==================== 待结算列表 ==================== -->
  <block wx:if="{{orders.length > 0 && activeTab === 'pending'}}">
    <view class="order-list">
      <view class="order-card pending-card" wx:for="{{orders}}" wx:key="order_id" bindtap="onOrderTap" data-item="{{item}}">
        <view class="card-left">
          <image class="card-thumb" src="/images/default-goods.png" mode="aspectFill" />
        </view>
        <view class="card-center">
          <view class="card-row">
            <text class="card-label">订单号</text>
            <text class="card-value id-value">{{item.order_id}}</text>
          </view>
          <view class="card-row">
            <text class="card-label">商品编号</text>
            <text class="card-value id-value">{{item.goods_id}}</text>
          </view>
          <view class="card-row">
            <text class="card-label">期望售价</text>
            <text class="card-value">¥{{item.goods_price_str}}</text>
          </view>
          <view class="card-row">
            <text class="card-label">服务费</text>
            <text class="card-value deal-value">¥{{item.service_fee}}</text>
          </view>
          <view class="card-row settle-row">
            <text class="card-label">待结算价</text>
            <text class="card-value settle-value">¥{{item.settle_price}}</text>
          </view>
          <view class="card-tip">* 已扣除服务费 ¥{{item.service_fee}}</view>
        </view>
      </view>
    </view>
    <van-divider wx:if="{{orders.length > 0}}" contentPosition="center">没有更多了</van-divider>
  </block>

  <!-- ==================== 已完成列表 ==================== -->
  <block wx:if="{{orders.length > 0 && activeTab === 'done'}}">
    <view class="order-list">
      <view class="order-card done-card" wx:for="{{orders}}" wx:key="order_id" bindtap="onOrderTap" data-item="{{item}}">
        <view class="card-left">
          <image class="card-thumb" src="/images/default-goods.png" mode="aspectFill" />
        </view>
        <view class="card-center">
          <view class="card-row">
            <text class="card-label">订单号</text>
            <text class="card-value id-value">{{item.order_id}}</text>
          </view>
          <view class="card-row">
            <text class="card-label">商品编号</text>
            <text class="card-value id-value">{{item.goods_id}}</text>
          </view>
          <view class="card-row">
            <text class="card-label">期望售价</text>
            <text class="card-value deal-value">¥{{item.goods_price_str}}</text>
          </view>
          <view class="card-row settle-row">
            <text class="card-label">结算价</text>
            <text class="card-value settle-value">¥{{item.settle_price}}</text>
          </view>
          <view class="card-tip">* 已扣除服务费 ¥{{item.service_fee}}</view>
        </view>
      </view>
    </view>
    <van-divider wx:if="{{orders.length > 0}}" contentPosition="center">没有更多了</van-divider>
  </block>
</view>

<!-- 降价弹窗 -->
<view class="modal-mask" wx:if="{{showPriceModal}}" catchtap="hidePriceModal"></view>
<view class="price-modal" wx:if="{{showPriceModal}}">
  <view class="modal-header">修改期望售价</view>
  <view class="modal-body">
    <view class="modal-info">
      <text>当前售价：</text>
      <text class="current-price">¥{{priceItem.goods_price_str}}</text>
    </view>
    <view class="modal-input-wrap">
      <text class="input-prefix">¥</text>
      <input class="modal-input" type="digit" placeholder="请输入更低的价格" value="{{newPrice}}" bindinput="onPriceInput" focus />
    </view>
    <view class="modal-tip">新价格必须低于原期望售价</view>
  </view>
  <view class="modal-footer">
    <view class="modal-btn cancel-btn" catchtap="hidePriceModal">取消</view>
    <view class="modal-btn confirm-btn" catchtap="confirmLowerPrice">确认降价</view>
  </view>
</view>
