.container {
  background-color: #E4FFED;
  min-height: 100vh;
  padding: 20rpx;
}
.scroll-view { height: calc(100vh - 20rpx); }
.section {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 80, 0, 0.06);
}
.section-title {
  font-size: 32rpx;
  font-weight: 600;
  border-left: 8rpx solid #026302;
  padding-left: 20rpx;
  margin-bottom: 30rpx;
  color: #026302;
}
.form-item { margin-bottom: 30rpx; }
.label { font-size: 28rpx; color: #026302; margin-bottom: 16rpx; font-weight: 500; }
.input, .textarea {
  border: 2rpx solid #C8E6C9;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  background-color: #E4FFED;
  color: #026302;
}
.textarea { width: 100%; min-height: 150rpx; }
.media-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}
.media-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background-color: #C8E6C9;
}
.video-item { background-color: #000; }
.preview-image, .preview-video { width: 100%; height: 100%; }
.delete-btn {
  position: absolute;
  top: 0;
  right: 0;
  width: 48rpx;
  height: 48rpx;
  background-color: rgba(0,0,0,0.6);
  color: #fff;
  text-align: center;
  line-height: 48rpx;
  border-radius: 0 0 0 12rpx;
  font-size: 36rpx;
}
.add-btn {
  width: 200rpx;
  height: 200rpx;
  border: 2rpx dashed #026302;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  color: #026302;
  background-color: #E4FFED;
}
.submit-btn {
  border-radius: 48rpx;
  background-color: #b7e4b7;
  color: #026302;
  margin: 20rpx 0 60rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 115, 0, 0.15);
  font-weight: 600;
}

.submit-btn:active {
  background-color: #026302;
  color: #ffffff;
}
