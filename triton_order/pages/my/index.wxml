<view class="page-container">
  <view class="header-section">
    <view wx:if="{{ !hasLogined }}" class="login-container">
      <view class="login-tips">欢迎</view>
      <view class="login-btn" bindtap="login">
        <text>登录</text>
      </view>
    </view>
    
    <view wx:else class="user-info-container" bindtap="showEditProfile">
      <view class="user-main">
        <view class="avatar-wrap">
          <image class="avatar" src="{{userInfoMap.avatar || '/images/default-avatar.png'}}" mode="aspectFill" />
        </view>
        <view class="user-detail">
          <view class="nickname-row">
            <text class="nickname">{{ userInfoMap.nick ? userInfoMap.nick : '点击设置昵称' }}</text>
          </view>
          <view class="user-id">ID: {{ userInfoMap.user_id }}</view>
          <view class="user-level">等级：{{ userInfoMap.level || '普通用户' }}</view>
        </view>
      </view>
    </view>
    
  </view>

  <!-- 编辑用户信息弹窗 -->
  <view class="modal-mask" wx:if="{{showEditModal}}" bindtap="hideEditModal"></view>
  <view class="modal-container" wx:if="{{showEditModal}}">
    <view class="modal-header">编辑个人资料</view>
    <view class="modal-body">
      <!-- 头像编辑 -->
      <view class="edit-avatar-section">
        <text class="edit-label">头像</text>
        <view class="edit-avatar-wrap" bindtap="chooseAvatar">
          <image class="edit-avatar" src="{{editAvatar || userInfoMap.avatar || '/images/default-avatar.png'}}" mode="aspectFill" />
          <view class="edit-avatar-tip">点击更换</view>
        </view>
      </view>
      <!-- 昵称编辑 -->
      <view class="edit-nick-section">
        <text class="edit-label">昵称</text>
        <input class="edit-nick-input" value="{{editNick}}" placeholder="请输入昵称" bindinput="onNickInput" maxlength="20" />
      </view>
      <!-- 卖家服务费（仅寄售商家） -->
      <view class="edit-nick-section" wx:if="{{isBanker}}">
        <text class="edit-label">卖家服务费</text>
        <input class="edit-nick-input" value="{{editTaxRatioToSaler}}" placeholder="输入比例（%）" bindinput="onTaxRatioToSalerInput" type="digit" />
      </view>
      <!-- 买家服务费（仅寄售商家） -->
      <view class="edit-nick-section" wx:if="{{isBanker}}">
        <text class="edit-label">买家服务费</text>
        <input class="edit-nick-input" value="{{editTaxRatioToBuyer}}" placeholder="输入比例（%）" bindinput="onTaxRatioToBuyerInput" type="digit" />
      </view>
      <!-- 收取固定服务费的价格（仅寄售商家） -->
      <view class="edit-nick-section" wx:if="{{isBanker}}">
        <text class="edit-label">固定服务费起收价</text>
        <input class="edit-nick-input" value="{{editFixedTaxPrice}}" placeholder="输入价格" bindinput="onFixedTaxPriceInput" type="digit" />
      </view>
      <!-- 固定服务费的数额（仅寄售商家） -->
      <view class="edit-nick-section" wx:if="{{isBanker}}">
        <text class="edit-label">固定服务费数额</text>
        <input class="edit-nick-input" value="{{editFixedTaxValue}}" placeholder="输入数额" bindinput="onFixedTaxValueInput" type="digit" />
      </view>
    </view>
    <view class="modal-footer">
      <view class="modal-btn cancel-btn" bindtap="hideEditModal">取消</view>
      <view class="modal-btn confirm-btn" bindtap="saveProfile">保存</view>
    </view>
  </view>

  <view class="other-section">
    <view class="section-title">订单</view>
    <block wx:if="{{isBanker}}">
      <view bindtap="createInputOrder" class="menu-item">
        <view class="menu-label">新建寄售单</view>
        <text class="arrow">创建后分享给玩家填写</text>
      </view>
      <view bindtap="switchToInputOrders" class="menu-item">
        <view class="menu-label">入库记录</view>
        <text class="arrow"></text>
      </view>
      <view bindtap="switchToOutputOrders" class="menu-item">
        <view class="menu-label">出库记录</view>
        <text class="arrow"></text>
      </view>
      <navigator url="/pages/my/my_products" class="menu-item">
        <view class="menu-label">我的库存</view>
        <text class="arrow"></text>
      </navigator>
      <navigator url="/pages/goods/sublist_status" class="menu-item">
        <view class="menu-label">订单状态</view>
        <text class="arrow">查看订单流转状态</text>
      </navigator>
    </block>
    <block wx:else>
      <view bindtap="switchToMyPurchase" class="menu-item">
        <view class="menu-label">我的购买</view>
        <text class="arrow"></text>
      </view>
      <view bindtap="switchToMySale" class="menu-item">
        <view class="menu-label">我的寄售</view>
        <text class="arrow"></text>
      </view>
    </block>
    <navigator url="/pages/my/select_addr" class="menu-item">
      <view class="menu-label">我的地址</view>
      <text class="arrow">我的地址</text>
    </navigator>
    <navigator url="/pages/my/money" class="menu-item">
      <view class="menu-label">我的账单</view>
      <text class="arrow">账单</text>
    </navigator>

  </view>

  <view wx:if="{{ hasLogined }}" class="logout-section">
    <view bindtap="logout" class="logout-btn">
      <text class="logout-icon">⏻</text>
      <text class="logout-text">退出登录</text>
    </view>
  </view>
</view>
