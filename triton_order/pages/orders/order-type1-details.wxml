<view class="page-container">
  <!-- 状态卡片 -->
  <view class="status-card">
    <view class="status-card-row">
      <view class="status-header">
        <view class="status-badge {{orderDetails.order_status < 0 ? 'warning' : orderDetails.order_status >= 9 ? 'success' : 'active'}}">
          {{orderDetails.order_status < 0 ? '待确认' : orderDetail.orderStatus >= 9 ? '已完成' : '进行中'}}
        </view>
        <view class="status-title">{{orderCurrentStep}}</view>
        <view class="order-number">订单ID: {{orderID || '加载中...'}}</view>
      </view>
      <!-- 买家诚信度 -->
      <view class="status-credit-area">
        <text class="credit-label">买家诚信度</text>
        <text class="credit-score">100</text>
      </view>
    </view>
  </view>

  <!-- 商品信息 -->
  <view class="section-block">
    <view class="section-header">
      <view class="section-title">商品信息</view>
    </view>
    <view class="card goods-card">
      <wxs module="goodsDetailPage">
        module.exports = {
          url : function(goodsId) {
            return '/pages/goods-details/index?id=' + goodsId
          }
        }
      </wxs>
      <view class="goods-content" bindtap="navigateToGoods" data-id="{{goodsID}}">
        <image class="goods-thumb" src="{{goodInfo.pic}}" mode="aspectFill" />
        <view class="goods-info">
          <view class="goods-name">{{goodInfo.name}}</view>
          <view class="goods-desc">{{goodInfo.description}}</view>
          <view class="goods-price">¥{{goodInfo.price}}</view>
        </view>
        <view class="goods-arrow">›</view>
      </view>
    </view>
  </view>

  <!-- 订单信息 -->
  <view class="section-block">
    <view class="section-header">
      <view class="section-title">订单信息</view>
    </view>
    <view class="card info-card">
      <!-- 价格 -->
      <view class="info-row">
        <view class="info-label">出价金额</view>
        <view class="info-value">
          <input class="input-field" type="digit" placeholder="输入价格" value="{{orderDetails.price}}" disabled="{{(orderDetails.order_status > -1)}}" bindinput="onPriceInput" />
        </view>
      </view>

      <!-- 发件人地址 -->
      <view class="info-row" wx:if="{{senderAddrNeeded}}">
        <view class="info-label">发货地址</view>
        <view class="info-value">
          <input class="input-field" placeholder="输入发货地址" value="{{orderDetails.sender_addr}}" bindinput="onSenderAddrInput" maxlength="200" />
        </view>
      </view>

      <!-- 收件人地址 -->
      <view class="info-row" wx:if="{{recverAddrNeeded}}">
        <view class="info-label">收货地址</view>
        <view class="info-value">
          <input class="input-field" placeholder="输入收货地址" value="{{orderDetails.recver_addr}}" bindinput="onRecverAddrInput" maxlength="200" />
        </view>
      </view>

      <!-- 发货快递 -->
      <view class="info-row" wx:if="{{postID0Needed}}">
        <view class="info-label">发货快递</view>
        <view class="info-value">
          <input class="input-field" placeholder="输入快递单号" value="{{orderDetails.postID0}}" bindinput="onPostIDInput" maxlength="50" />
        </view>
      </view>

      <!-- 收货快递 -->
      <view class="info-row" wx:if="{{postID1Needed}}">
        <view class="info-label">收货快递</view>
        <view class="info-value">
          <input class="input-field" placeholder="输入快递单号" value="{{orderDetails.postID1}}" bindinput="onPostIDInput" maxlength="50" />
        </view>
      </view>
    </view>
  </view>

  <!-- 支付凭证 -->
  <view class="section-block" wx:if="{{(isBanker||isBuyer) && paymentNeeded}}">
    <view class="section-header">
      <view class="section-title">支付凭证</view>
      <view class="section-subtitle" wx:if="{{!orderDetails.payment && isBuyer}}">点击添加付款截图</view>
    </view>
    <view class="card">
      <view class="payment-area">
        <view class="add-btn" wx:if="{{!orderDetails.payment && isBuyer}}" bindtap="addPaymentImage">+</view>
        <view class="preview-container" wx:elif="{{orderDetails.payment}}">
          <image class="preview-image" src="{{orderDetails.payment.url}}" mode="aspectFill" bindtap="previewImage" data-url="{{orderDetails.payment.url}}" />
          <view class="delete-btn" catchtap="deletePaymentImage">
            <text class="delete-icon">×</text>
          </view>
        </view>
        <view class="payment-placeholder" wx:else>
          <text class="placeholder-text">暂无支付凭证</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 操作按钮 -->
  <view class="action-area">
    <button class="btn btn-primary" disabled="{{updatingDisabled}}" bind:tap="nextStep">
      {{orderNextStep}}
    </button>
    <button class="btn btn-outline" disabled="{{cancelingDisabled}}" bind:tap="cancelOrder">
      取消
    </button>
  </view>

  <!-- 订单记录 -->
  <view class="section-block" wx:if="{{orderDetails.logs && orderDetails.logs.length > 0}}">
    <view class="section-header">
      <view class="section-title">订单记录</view>
    </view>
    <view class="card timeline-card">
      <view class="timeline">
        <view class="timeline-item" wx:for="{{orderDetails.logs}}" wx:key="id">
          <view class="timeline-dot"></view>
          <view class="timeline-line" wx:if="{{index < orderDetails.logs.length - 1}}"></view>
          <view class="timeline-content">
            <view class="log-operation">{{item.typeStr}}</view>
            <view class="log-time">{{item.dateAdd}}</view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="bottom-safe-area"></view>
</view>
