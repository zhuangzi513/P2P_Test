page {
  min-height: 100%;
  background: #E4FFED;
}

.page-container {
  min-height: 100%;
  padding: 24rpx;
  padding-bottom: env(safe-area-inset-bottom);
}

/* 状态卡片 */
.status-card {
  background: linear-gradient(135deg, #026302 0%, #047504 100%);
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 115, 0, 0.3);
}

.status-card-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.status-header {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  flex: 1;
}

.status-badge {
  font-size: 22rpx;
  font-weight: 500;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  margin-bottom: 16rpx;
  color: #fff;
}

.status-badge.active {
  background: rgba(255, 255, 255, 0.2);
}

.status-badge.success {
  background: rgba(72, 199, 142, 0.9);
}

.status-badge.warning {
  background: rgba(255, 179, 71, 0.9);
}

.status-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 12rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.order-number {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  letter-spacing: 1rpx;
}

/* 区块容器 */
.section-block {
  margin-bottom: 32rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 8rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #026302;
}

.section-subtitle {
  font-size: 22rpx;
  color: #999;
}

/* 卡片 */
.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

/* 商品卡片 */
.goods-card {
  padding: 0;
  overflow: hidden;
}

.goods-content {
  display: flex;
  align-items: center;
  padding: 24rpx;
  transition: background-color 0.2s;
}

.goods-content:active {
  background-color: #E4FFED;
}

.goods-thumb {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  background: #f5f7fa;
  flex-shrink: 0;
}

.goods-info {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.goods-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #026302;
  margin-bottom: 12rpx;
  line-height: 1.4;
}

.goods-desc {
  font-size: 24rpx;
  color: #047504;
  margin-bottom: 16rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.goods-price {
  font-size: 34rpx;
  font-weight: 700;
  color: #E4393C;
}

.goods-arrow {
  font-size: 48rpx;
  color: #ccc;
  padding-left: 16rpx;
}

/* 信息卡片 */
.info-card {
  padding: 0;
}

.info-row {
  display: flex;
  align-items: center;
  padding: 28rpx;
  border-bottom: 1rpx solid #C8E6C9;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  width: 160rpx;
  font-size: 28rpx;
  color: #026302;
  flex-shrink: 0;
}

.info-value {
  flex: 1;
}

.input-field {
  width: 100%;
  font-size: 28rpx;
  color: #026302;
  text-align: right;
  background: transparent;
}

.input-field::placeholder {
  color: #ccc;
}

.input-field[disabled] {
  color: #047504;
  background-color: #E4FFED;
  opacity: 0.7;
}

/* 应付金额 */
.payable-row {
  border-bottom: none;
}

.payable-value {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.payable-amount {
  font-size: 32rpx;
  font-weight: 700;
  color: #CC0000;
}

.payable-detail {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

/* 买家诚信度（状态卡片右侧） */
.status-credit-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-left: 24rpx;
  flex-shrink: 0;
}

.credit-label {
  font-size: 36rpx;
  font-weight: 900;
  color: rgba(255, 255, 255, 0.7);
  margin-bottom: 8rpx;
}

.credit-score {
  font-size: 36rpx;
  font-weight: bold;
  color: #ffd700;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
}

/* 支付区域 */
.payment-area {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 200rpx;
}

.add-btn {
  width: 160rpx;
  height: 160rpx;
  border: 2rpx dashed #ddd;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  color: #ccc;
  transition: all 0.2s;
}

.add-btn:active {
  border-color: #026302;
  color: #026302;
  transform: scale(0.98);
}

.preview-container {
  width: 100%;
}

.preview-image {
  width: 100%;
  height: 400rpx;
  border-radius: 12rpx;
  background: #f5f7fa;
}

.payment-placeholder {
  text-align: center;
}

.placeholder-text {
  font-size: 26rpx;
  color: #ccc;
}

/* 操作按钮 */
.action-area {
  display: flex;
  gap: 24rpx;
  margin: 32rpx 0;
}

.btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  padding: 0;
  margin: 0;
}

.btn::after {
  border: none;
}

.btn-primary {
  background: #b7e4b7;
  color: #026302;
  box-shadow: 0 8rpx 24rpx rgba(0, 115, 0, 0.15);
}

.btn-primary:active {
  background: #026302;
  color: #ffffff;
}

.btn-primary[disabled] {
  background: #c4c4c4;
  color: #999;
  box-shadow: none;
}

.btn-outline {
  background: #ffffff;
  color: #666;
  border: 2rpx solid #e0e0e0;
}

.btn-outline[disabled] {
  color: #ccc;
  border-color: #f0f0f0;
}

/* 时间线卡片 */
.timeline-card {
  padding: 32rpx;
}

.timeline {
  position: relative;
  padding-left: 48rpx;
}

.timeline-item {
  position: relative;
  padding-bottom: 48rpx;
}

.timeline-item:last-child {
  padding-bottom: 0;
}

.timeline-dot {
  position: absolute;
  left: -48rpx;
  top: 8rpx;
  width: 24rpx;
  height: 24rpx;
  background: linear-gradient(135deg, #026302 0%, #047504 100%);
  border-radius: 50%;
  border: 4rpx solid #ffffff;
  box-shadow: 0 0 0 4rpx #C8E6C9;
  z-index: 2;
}

.timeline-line {
  position: absolute;
  left: -36rpx;
  top: 40rpx;
  bottom: -32rpx;
  width: 2rpx;
  background: linear-gradient(to bottom, #C8E6C9 0%, #E4FFED 100%);
  z-index: 1;
}

.timeline-content {
  background: linear-gradient(135deg, #E4FFED 0%, #ffffff 100%);
  border-radius: 12rpx;
  padding: 24rpx;
  border: 1rpx solid #C8E6C9;
}

.log-operation {
  font-size: 28rpx;
  font-weight: 600;
  color: #026302;
  margin-bottom: 12rpx;
}

.log-time {
  font-size: 24rpx;
  color: #047504;
  display: flex;
  align-items: center;
}

.log-time::before {
  content: '🕐';
  margin-right: 8rpx;
  font-size: 22rpx;
}

/* 底部安全区域 */
.bottom-safe-area {
  height: 60rpx;
}
