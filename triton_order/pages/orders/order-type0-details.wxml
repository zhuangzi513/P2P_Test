<view class="page-container">
  <!-- 状态卡片 -->
  <view class="status-banner">
    <view class="status-badge {{orderDetail.order_status >= 0 ? 'active' : 'pending'}}">
      <text class="status-icon">{{orderDetail.order_status >= 5 ? '✓' : '⏳'}}</text>
    </view>
    <view class="status-content">
      <text class="status-text">{{orderNextStep}}</text>
      <text class="order-id">订单号: {{orderDetail.order_id || orderID }}</text>
    </view>
  </view>

  <!-- 商品卡片 -->
  <view class="card goods-card">
    <view class="card-header">
      <text class="card-title">商品信息</text>
    </view>
    <wxs module="goodsDetailPage">
      module.exports = {
        url: function(goodsId) {
          return '/pages/goods-details/index?id=' + goodsId
        }
      }
    </wxs>
    <view class="goods-item" bindtap="goGoodsDetail">
      <image class="goods-thumb" src="{{goodInfo.pic}}" mode="aspectFill" />
      <view class="goods-info">
        <text class="goods-name">{{goodInfo.goodsName}}</text>
        <text class="goods-desc">{{goodInfo.description}}</text>
        <text class="goods-price">¥{{goodInfo.price}}</text>
      </view>
      <view class="goods-arrow">›</view>
    </view>
  </view>

  <!-- 表单区域 -->
  <scroll-view scroll-y class="form-scroll">
    <!-- 基本信息 -->
    <view class="card form-card">
      <view class="card-header">
        <text class="card-title">基本信息</text>
        <text class="role-tag" wx:if="{{isOwner}}">物主</text>
        <text class="role-tag banker" wx:if="{{isBanker}}">托管方</text>
      </view>
      
      <view class="form-grid">
        <view class="form-row">
          <view class="form-label">名称</view>
          <input class="form-input {{isOwner ? '' : 'disabled'}}" 
                 placeholder="请输入商品名称" 
                 disabled="{{!isOwner}}" 
                 value="{{goodInfo.name}}" 
                 bindinput="onNameInput" />
        </view>
        
        <view class="form-row">
          <view class="form-label">颜色</view>
          <input class="form-input {{isOwner ? '' : 'disabled'}}" 
                 placeholder="请输入颜色" 
                 disabled="{{!isOwner}}" 
                 value="{{goodInfo.color}}" 
                 bindinput="onColorInput" />
        </view>
        
        <view class="form-row triple">
          <view class="form-item">
            <view class="form-label">尺寸-X</view>
            <input class="form-input {{isOwner ? '' : 'disabled'}}" 
                   placeholder="X" 
                   disabled="{{!isOwner}}" 
                   value="{{goodInfo.sizeX}}" 
                   bindinput="onSizeInputX" />
          </view>
          <view class="form-item">
            <view class="form-label">尺寸-Y</view>
            <input class="form-input {{isOwner ? '' : 'disabled'}}" 
                   placeholder="Y" 
                   disabled="{{!isOwner}}" 
                   value="{{goodInfo.sizeY}}" 
                   bindinput="onSizeInputY" />
          </view>
          <view class="form-item">
            <view class="form-label">尺寸-Z</view>
            <input class="form-input {{isOwner ? '' : 'disabled'}}" 
                   placeholder="Z" 
                   disabled="{{!isOwner}}" 
                   value="{{goodInfo.sizeZ}}" 
                   bindinput="onSizeInputZ" />
          </view>
        </view>
        
        <view class="form-row">
          <view class="form-label">价格</view>
          <view class="price-input-wrapper">
            <text class="price-symbol">¥</text>
            <input class="form-input price-input {{isOwner ? '' : 'disabled'}}" 
                   type="digit" 
                   placeholder="0.00" 
                   disabled="{{!isOwner}}" 
                   value="{{goodInfo.price}}" 
                   bindinput="onPriceInput" />
          </view>
        </view>
        
        <view class="form-row">
          <view class="form-label">描述</view>
          <textarea class="form-textarea" 
                    placeholder="请输入商品描述..." 
                    disabled="{{!isOwner}}" 
                    value="{{goodInfo.description}}" 
                    bindinput="onDescInput" 
                    maxlength="200" />
        </view>
      </view>
    </view>

    <!-- 图片区域 -->
    <view class="card form-card media-card">
      <view class="card-header">
        <text class="card-title">商品图片</text>
        <text class="img-count">{{goodInfo.imageList.length}}/9</text>
      </view>
      
      <!-- 已上传图片 -->
      <view class="image-grid" wx:if="{{goodInfo.imageList.length > 0}}">
        <view class="image-item" wx:for="{{goodInfo.imageList}}" wx:key="index">
          <image class="preview-image" src="{{item.url}}" mode="aspectFill" bindtap="previewImage" data-url="{{item.url}}" />
          <view class="delete-btn" catchtap="deleteImage" data-index="{{index}}">
            <text class="delete-icon">✕</text>
          </view>
        </view>
      </view>
      
      <!-- 上传按钮组 -->
      <view class="upload-actions" wx:if="{{isOwner}}">
        <view class="upload-btn image-upload-btn" bindtap="addImage">
          <view class="upload-icon-wrapper">
            <text class="upload-icon">🖼️</text>
          </view>
          <view class="upload-info">
            <text class="upload-title">上传图片</text>
            <text class="upload-hint">最多9张</text>
          </view>
          <view class="upload-arrow">›</view>
        </view>
        
        <view class="upload-btn video-upload-btn" bindtap="addVideo">
          <view class="upload-icon-wrapper">
            <text class="upload-icon">🎬</text>
          </view>
          <view class="upload-info">
            <text class="upload-title">上传视频</text>
            <text class="upload-hint">最多3个</text>
          </view>
          <view class="upload-arrow">›</view>
        </view>
      </view>
      
      <!-- 空状态提示 -->
      <view class="empty-state" wx:if="{{goodInfo.imageList.length === 0 && !isOwner}}">
        <text class="empty-icon">📷</text>
        <text class="empty-text">暂无图片</text>
      </view>
    </view>

    <!-- 地址信息 -->
    <view class="card form-card" wx:if="{{isOwner || isBanker}}">
      <view class="card-header">
        <text class="card-title">物流信息</text>
      </view>
      
      <view class="form-row">
        <view class="form-label">发货地址</view>
        <textarea class="form-textarea small" 
                  placeholder="请输入发货地址" 
                  disabled="{{!isOwner}}" 
                  value="{{orderDetail.senderAddr}}" 
                  bindinput="onSenderAddrInput" 
                  maxlength="200" />
      </view>
      
      <view class="form-row">
        <view class="form-label">收货地址</view>
        <textarea class="form-textarea small" 
                  placeholder="请输入收货地址" 
                  disabled="{{!isBanker}}" 
                  value="{{orderDetail.recverAddr}}" 
                  bindinput="onRecverAddrInput" 
                  maxlength="200" />
      </view>
      
      <view class="form-row">
        <view class="form-label">发货快递</view>
        <input class="form-input {{isOwner ? '' : 'disabled'}}" 
               placeholder="请输入快递单号" 
               disabled="{{!isOwner}}" 
               value="{{orderDetail.postID0}}" 
               bindinput="onPostIDInput" />
      </view>
      
      <view class="form-row">
        <view class="form-label">回寄快递</view>
        <input class="form-input {{isBanker ? '' : 'disabled'}}" 
               placeholder="请输入快递单号" 
               disabled="{{!isBanker}}" 
               value="{{orderDetail.postID1}}" 
               bindinput="onPostIDInput" />
      </view>
    </view>

    <!-- 操作按钮 -->
    <view class="action-section">
      <button class="btn-primary {{updatingDisabled ? 'disabled' : ''}}" 
              disabled="{{updatingDisabled}}" 
              bindtap="nextStep">
        <text class="btn-icon">→</text>
        {{orderNextStep}}
      </button>
      <button class="btn-secondary" bindtap="cancelOrder">
        取消订单
      </button>
    </view>

    <!-- 订单记录 -->
    <view class="card log-card" wx:if="{{orderDetail.logs && orderDetail.logs.length > 0}}">
      <view class="card-header">
        <text class="card-title">订单记录</text>
      </view>
      <view class="timeline">
        <view class="timeline-item" wx:for="{{orderDetail.logs}}" wx:key="id">
          <view class="timeline-dot"></view>
          <view class="timeline-line" wx:if="{{index < orderDetail.logs.length - 1}}"></view>
          <view class="timeline-content">
            <text class="log-operation">{{item.typeStr}}</text>
            <text class="log-time">{{item.dateAdd}}</text>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>

  <view class="bottom-safe-area"></view>
</view>
