<view class="page-container">
  <!-- 分享卡片（新建订单时显示） -->
  <view class="share-card" wx:if="{{isNewOrder}}">
    <view class="share-card-header">
      <text class="share-card-icon">📋</text>
      <text class="share-card-title">分享寄售单给玩家</text>
    </view>
    <view class="share-card-desc">点击下方按钮，将寄售单发送给玩家填写商品信息</view>
    <button class="share-card-btn" open-type="share">
      <text class="share-btn-icon">💬</text>
      分享给好友填写
    </button>
  </view>

  <!-- 状态卡片 -->
  <view class="status-banner" wx:if="{{false}}">
    <view class="status-badge {{orderDetails.order_status >= 0 ? 'active' : 'pending'}}">
      <text class="status-icon">{{orderDetails.order_status >= 5 ? '✓' : '⏳'}}</text>
    </view>
    <view class="status-content">
      <text class="status-text">当前状态：{{orderNextStep}}</text>
      <text class="order-id">订单号: {{orderDetails.order_id || orderID }}</text>
    </view>
  </view>

  <!-- 寄售商家收件信息 -->
  <view class="card banker-addr-card" wx:if="{{bankerAddress}}">
    <view class="card-header">
      <text class="card-title">📦 寄售商家收件信息</text>
      <view class="copy-btn" bindtap="copyBankerAddress">
        <text class="copy-icon">📋</text>
        <text class="copy-text">一键复制</text>
      </view>
    </view>
    <view class="addr-info-grid">
      <view class="addr-info-row">
        <text class="addr-label">收件人</text>
        <text class="addr-value">{{bankerAddress.linkMan}}</text>
      </view>
      <view class="addr-info-row">
        <text class="addr-label">联系电话</text>
        <text class="addr-value addr-mobile">{{bankerAddress.mobile}}</text>
      </view>
      <view class="addr-info-row">
        <text class="addr-label">收件地址</text>
        <text class="addr-value">{{bankerAddress.address}}</text>
      </view>
    </view>
    <view class="addr-tip">请将商品寄送至以上地址</view>
  </view>

  <!-- 商品卡片 -->
  <view class="card goods-card">
    <view class="card-header">
      <text class="card-title">商品信息</text>
    </view>
    <wxs module="goodsDetailPage">
      module.exports = {
        url: function(goodsId) {
          return '/pages/goods-details/index?id=' + goodsId
        }
      }
    </wxs>
    <view class="goods-item" bindtap="goGoodsDetail">
      <image class="goods-thumb" src="{{goodInfo.pic}}" mode="aspectFill" />
      <view class="goods-info">
        <text class="goods-name">{{goodInfo.goodsName}}</text>
        <text class="goods-desc">{{goodInfo.description}}</text>
        <text class="goods-price">¥{{goodInfo.price}}</text>
      </view>
      <view class="goods-arrow">›</view>
    </view>
  </view>

  <!-- 表单区域 -->
  <scroll-view scroll-y class="form-scroll">
    <!-- 基本信息 -->
    <view class="card form-card">
      <view class="card-header">
        <text class="card-title">基本信息</text>
        <text class="role-tag" wx:if="{{isOwner}}">物主</text>
        <text class="role-tag banker" wx:if="{{isBanker}}">托管方</text>
      </view>
      
      <view class="form-grid">
        <view class="form-row">
          <view class="form-label">名称</view>
          <input class="form-input {{isOwner && !editPriceOnly ? '' : 'disabled'}}" 
                 placeholder="请输入商品名称（例：佛公吊坠）" 
                 disabled="{{!isOwner || editPriceOnly}}" 
                 value="{{goodInfo.name}}" 
                 bindinput="onNameInput" />
        </view>
        
        <view class="form-row triple">
          <view class="form-item">
            <view class="form-label">尺寸-X</view>
            <input class="form-input {{isBanker ? '' : 'disabled'}}" 
                   placeholder="X" 
                   disabled="{{!isBanker}}" 
                   value="{{goodInfo.sizeX}}" 
                   bindinput="onSizeInputX" />
          </view>
          <view class="form-item">
            <view class="form-label">尺寸-Y</view>
            <input class="form-input {{isBanker ? '' : 'disabled'}}" 
                   placeholder="Y" 
                   disabled="{{!isBanker}}" 
                   value="{{goodInfo.sizeY}}" 
                   bindinput="onSizeInputY" />
          </view>
          <view class="form-item">
            <view class="form-label">尺寸-Z</view>
            <input class="form-input {{isBanker ? '' : 'disabled'}}" 
                   placeholder="Z" 
                   disabled="{{!isBanker}}" 
                   value="{{goodInfo.sizeZ}}" 
                   bindinput="onSizeInputZ" />
          </view>
        </view>
        
        <view class="form-row">
          <view class="form-label">购入渠道（选填）</view>
          <input class="form-input {{isOwner && !editPriceOnly ? '' : 'disabled'}}" 
                 placeholder="例：六舒闲置" 
                 disabled="{{!isOwner || editPriceOnly}}" 
                 value="{{goodInfo.channel}}" 
                 bindinput="onChannelInput" />
        </view>
        
        <view class="form-row">
          <view class="form-label">购入价格（选填）</view>
          <view class="price-input-wrapper">
            <text class="price-symbol">¥</text>
            <input class="form-input price-input {{isOwner && !editPriceOnly ? '' : 'disabled'}}" 
                   type="digit" 
                   placeholder="0.00" 
                   disabled="{{!isOwner || editPriceOnly}}" 
                   value="{{goodInfo.purchasePrice}}" 
                   bindinput="onPurchasePriceInput" />
          </view>
        </view>
        
        <view class="form-row">
          <view class="form-label">期望售价</view>
          <view class="price-input-wrapper">
            <text class="price-symbol">¥</text>
            <input class="form-input price-input {{isOwner ? '' : 'disabled'}}" 
                   type="digit" 
                   placeholder="0.00" 
                   disabled="{{!isOwner}}" 
                   value="{{goodInfo.price}}" 
                   bindinput="onPriceInput" />
          </view>
        </view>

        <!-- 应付金额 -->
        <view class="form-row payable-row">
          <view class="form-label">实收金额</view>
          <view class="payable-value">
            <text class="payable-amount">¥{{payableAmount}}</text>
            <text class="payable-detail">商品 ¥{{goodInfo.price || 0}} - 服务费 ¥{{serviceFee}}</text>
          </view>
        </view>
        
        <view class="form-row" wx:if="{{!editPriceOnly}}">
          <view class="checkbox-wrapper {{!isOwner ? 'disabled' : ''}}" bindtap="{{isOwner ? 'onFixedPriceToggle' : ''}}">
            <view class="checkbox-box {{goodInfo.fixedprice ? 'checked' : ''}}">
              <text class="checkbox-icon" wx:if="{{goodInfo.fixedprice}}">✓</text>
            </view>
            <text class="checkbox-text">一口价（不议价）</text>
          </view>
        </view>
        
        <!-- 更新商品信息按钮（非新建订单时物主可见） -->
        <view class="form-row" wx:if="{{isOwner && !isNewOrder && goodsID}}">
          <button class="btn-update-goods" bindtap="updateGoods">
            <text class="btn-update-icon">💾</text>
            {{editPriceOnly ? '保存价格' : '保存商品信息'}}
          </button>
        </view>

        <view class="form-row" wx:if="{{!editPriceOnly}}">
          <view class="form-label">补充描述（选填）</view>
          <textarea class="form-textarea" 
                    placeholder="例：有证书，天然钻石镶嵌/培育钻石镶嵌" 
                    disabled="{{!isOwner}}" 
                    value="{{goodInfo.description}}" 
                    bindinput="onDescInput" 
                    maxlength="200" />
        </view>
      </view>
    </view>

    <!-- 图片区域 -->
    <view class="card form-card media-card" wx:if="{{!editPriceOnly}}">
      <view class="card-header">
        <text class="card-title">商品图片</text>
        <text class="img-count">{{goodInfo.imageList.length}}/1</text>
      </view>
      
      <!-- 已上传图片 -->
      <view class="image-grid" wx:if="{{goodInfo.imageList.length > 0}}">
        <view class="image-item" wx:for="{{goodInfo.imageList}}" wx:key="index">
          <image class="preview-image" src="{{item.url}}" mode="aspectFill" bindtap="previewImage" data-url="{{item.url}}" />
          <view class="delete-btn" catchtap="deleteImage" data-index="{{index}}">
            <text class="delete-icon">✕</text>
          </view>
        </view>
      </view>
      
      <!-- 上传按钮组 -->
      <view class="upload-actions" wx:if="{{isOwner && goodInfo.imageList.length < 1}}">
        <view class="upload-btn image-upload-btn" bindtap="addImage">
          <view class="upload-icon-wrapper">
            <text class="upload-icon">🖼️</text>
          </view>
          <view class="upload-info">
            <text class="upload-title">上传图片</text>
            <text class="upload-hint">最多1张</text>
          </view>
          <view class="upload-arrow">›</view>
        </view>
      </view>
      
      <!-- 空状态提示 -->
      <view class="empty-state" wx:if="{{goodInfo.imageList.length === 0 && !isOwner}}">
        <text class="empty-icon">📷</text>
        <text class="empty-text">暂无图片</text>
      </view>
    </view>

    <!-- 地址信息 -->
    <view class="card form-card" wx:if="{{(isOwner || isBanker) && (SENDER_ADDR_ENABLED || RECVER_ADDR_ENABLED) }}">
      <view class="card-header">
        <text class="card-title">填写快递单号（只收顺丰快递）</text>
      </view>

      <!-- 发货地址 -->
      <view class="form-row" wx:if="{{SENDER_ADDR_ENABLED}}">
        <view class="form-label">发货地址</view>
        <view class="address-selector {{!isOwner ? 'disabled' : ''}}" bindtap="{{isOwner ? 'onSelectAddress' : ''}}" data-type="sender">
          <view class="address-text {{!isOwner ? 'disabled' : ''}}">
            {{orderDetails.sender_addr || '请选择发货地址'}}
          </view>
          <view class="select-arrow">›</view>
        </view>
      </view>
      
      <!-- 收货地址 -->
      <view class="form-row" wx:if="{{RECVER_ADDR_ENABLED}}">
        <view class="form-label">收货地址</view>
        <view class="address-selector {{!isBanker ? 'disabled' : ''}}" bindtap="{{isBanker ? 'onSelectAddress' : ''}}" data-type="recver">
          <view class="address-text {{!isBanker ? 'disabled' : ''}}">
            {{orderDetails.recver_addr || '请选择收货地址'}}
          </view>
          <view class="select-arrow">›</view>
        </view>
      </view>      
      
      <view class="form-row" wx:if="{{POST_ID0_ENABLED}}">
        <view class="form-label">发货快递</view>
        <input class="form-input " 
               placeholder="请输入快递单号" 
               disabled="{{!isOwner}}" 
               value="{{orderDetails.postID0}}" 
               bindinput="onPostIDInput" />
      </view>
      
      <view class="form-row" wx:if="{{POST_ID1_ENABLED}}">
        <view class="form-label">回寄快递</view>
        <input class="form-input" 
               placeholder="请输入快递单号" 
               disabled="{{!isBanker}}" 
               value="{{orderDetails.postID1}}" 
               bindinput="onPostIDInput" />
      </view>
    </view>

    <!-- 操作按钮 -->
    <view class="action-section">
      <button class="btn-primary {{updatingDisabled ? 'disabled' : ''}}" 
              disabled="{{updatingDisabled}}" 
              bindtap="nextStep">
        <text class="btn-icon">→</text>
        {{orderNextStep}}
      </button>
      <button class="btn-secondary" bindtap="cancelOrder">
        取消
      </button>
    </view>

    <!-- 订单记录 -->
    <view class="card log-card" wx:if="{{orderDetails.logs && orderDetails.logs.length > 0}}">
      <view class="card-header">
        <text class="card-title">订单记录</text>
      </view>
      <view class="timeline">
        <view class="timeline-item" wx:for="{{orderDetails.logs}}" wx:key="id">
          <view class="timeline-dot"></view>
          <view class="timeline-line" wx:if="{{index < orderDetails.logs.length - 1}}"></view>
          <view class="timeline-content">
            <text class="log-operation">{{item.typeStr}}</text>
            <text class="log-time">{{item.dateAdd}}</text>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>

  <view class="bottom-safe-area"></view>
</view>
