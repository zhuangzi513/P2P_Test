page {
  background-color: #E4FFED;
}

.page-container {
  min-height: 100vh;
  padding-bottom: 140rpx;
}

/* Header */
.section-header {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 32rpx 24rpx 28rpx;
}

.section-title {
  display: flex;
  align-items: center;
  justify-content: center;
}

.section-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #047504;
  position: relative;
}

.section-name::after {
  content: '';
  position: absolute;
  bottom: -6rpx;
  left: 0;
  width: 100%;
  height: 6rpx;
  background: linear-gradient(90deg, #026302 0%, #059505 50%, transparent 100%);
  border-radius: 3rpx;
}

/* Tab Bar */
.tab-bar {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  margin: 0 24rpx 20rpx;
  border-radius: 12rpx;
  overflow-x: auto;
  overflow-y: hidden;
  white-space: nowrap;
  box-shadow: 0 4rpx 12rpx rgba(0, 115, 0, 0.08);
}

.tab-item {
  flex-shrink: 0;
  text-align: center;
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  color: #666;
  position: relative;
  transition: all 0.3s ease;
}

.tab-item.tab-active {
  color: #047504;
  font-weight: bold;
}

.tab-item.tab-active::after {
  content: '';
  position: absolute;
  bottom: 4rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 36rpx;
  height: 4rpx;
  background: #026302;
  border-radius: 2rpx;
}

/* Order List */
.order-list {
  padding: 0 24rpx;
}

.order-card {
  display: flex;
  align-items: center;
  background: #E8F5E9;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  padding: 24rpx;
  box-shadow: 0 8rpx 16rpx rgba(0, 115, 0, 0.08);
  transition: all 0.3s ease;
}

.order-card:active {
  transform: scale(0.985);
  box-shadow: 0 4rpx 8rpx rgba(0, 115, 0, 0.12);
}

.card-left {
  flex-shrink: 0;
  margin-right: 20rpx;
}

.card-thumb {
  width: 140rpx;
  height: 140rpx;
  border-radius: 8rpx;
  background: #C8E6C9;
  border: 1rpx solid rgba(0, 115, 0, 0.1);
}

.card-center {
  flex: 1;
  min-width: 0;
}

.card-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
  font-size: 24rpx;
}

.card-row:last-child {
  margin-bottom: 0;
}

.card-label {
  color: #999;
  flex-shrink: 0;
  width: 120rpx;
}

.card-value {
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-value.id-value {
  font-size: 22rpx;
  color: #047504;
  font-weight: 500;
}

.card-value.name-value {
  flex: 1;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  color: #005000;
  font-weight: 500;
}

.card-value.price-value {
  font-size: 28rpx;
  color: #D32F2F;
  font-weight: bold;
}

.card-right {
  flex-shrink: 0;
  margin-left: 16rpx;
}

.status-tag {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  white-space: nowrap;
}

.status-active {
  color: #026302;
  background: #E4FFED;
  border: 1rpx solid rgba(2, 99, 2, 0.15);
}

.status-cancel {
  color: #999;
  background: #f5f5f5;
}

::-webkit-scrollbar {
  width: 0;
  height: 0;
  color: transparent;
}
