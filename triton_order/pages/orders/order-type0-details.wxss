page {
  min-height: 100%;
  background: #f8f9fc;
}

.page-container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* 状态横幅 */
.status-banner {
  display: flex;
  align-items: center;
  padding: 32rpx 32rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  margin: 24rpx;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.3);
}

.status-badge {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.status-badge.active {
  background: #52c41a;
}

.status-badge.pending {
  background: #faad14;
}

.status-icon {
  font-size: 36rpx;
  color: #fff;
}

.status-content {
  flex: 1;
}

.status-text {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 8rpx;
}

.order-id {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 卡片通用样式 */
.card {
  background: #fff;
  border-radius: 20rpx;
  margin: 0 24rpx 24rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f2f5;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
}

/* 角色标签 */
.role-tag {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border-radius: 20rpx;
}

.role-tag.banker {
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
}

/* 商品卡片 */
.goods-item {
  display: flex;
  align-items: center;
  padding: 16rpx;
  background: #fafbfc;
  border-radius: 16rpx;
  transition: all 0.3s ease;
}

.goods-thumb {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  margin-right: 24rpx;
  background: #f0f2f5;
}

.goods-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.goods-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goods-desc {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 12rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.goods-price {
  font-size: 34rpx;
  font-weight: 700;
  color: #ff6b6b;
}

.goods-arrow {
  font-size: 48rpx;
  color: #ccc;
  padding-left: 16rpx;
}

/* 表单区域 */
.form-scroll {
  flex: 1;
  height: calc(100vh - 280rpx);
}

.form-card {
  padding: 28rpx;
}

.form-grid {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.form-row {
  display: flex;
  flex-direction: column;
}

.form-row.triple {
  flex-direction: row;
  gap: 16rpx;
}

.form-row.triple .form-item {
  flex: 1;
}

.form-label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.form-input {
  height: 80rpx;
  padding: 0 24rpx;
  background: #f8f9fc;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #1a1a1a;
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
}

.form-input:focus {
  border-color: #667eea;
  background: #fff;
}

.form-input.disabled {
  background: #f5f5f5;
  color: #999;
}

.form-textarea {
  padding: 20rpx 24rpx;
  background: #f8f9fc;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #1a1a1a;
  min-height: 160rpx;
  border: 2rpx solid transparent;
  box-sizing: border-box;
}

.form-textarea.small {
  min-height: 80rpx;
}

.form-textarea.disabled {
  background: #f5f5f5;
  color: #999;
}

/* 价格输入 */
.price-input-wrapper {
  display: flex;
  align-items: center;
  background: #f8f9fc;
  border-radius: 12rpx;
  padding-left: 24rpx;
  border: 2rpx solid transparent;
}

.price-symbol {
  font-size: 32rpx;
  font-weight: 600;
  color: #ff6b6b;
}

.price-input {
  flex: 1;
  border: none;
  background: transparent;
  padding-left: 8rpx;
}

/* 图片网格 */
.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.img-count {
  font-size: 24rpx;
  color: #999;
}

.image-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
}

.preview-image {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
  background: #f0f2f5;
}

.delete-btn {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 44rpx;
  height: 44rpx;
  background: #ff4d4f;
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: bold;
  box-shadow: 0 4rpx 12rpx rgba(255, 77, 79, 0.4);
}

.add-image-btn {
  width: 200rpx;
  height: 200rpx;
  background: #f8f9fc;
  border: 2rpx dashed #d9d9d9;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.add-image-btn:active {
  background: #f0f2f5;
  border-color: #667eea;
}

.add-icon {
  font-size: 60rpx;
  color: #999;
  line-height: 1;
}

.add-text {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

/* 操作按钮 */
.action-section {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.btn-primary {
  height: 96rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border: none;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.4);
}

.btn-primary.disabled {
  background: #d9d9d9;
  box-shadow: none;
}

.btn-icon {
  margin-right: 12rpx;
  font-size: 28rpx;
}

.btn-secondary {
  height: 88rpx;
  background: #fff;
  color: #666;
  border: 2rpx solid #e8e8e8;
  border-radius: 48rpx;
  font-size: 28rpx;
}

.btn-secondary:active {
  background: #f5f5f5;
}

/* 时间线 */
.log-card {
  padding: 28rpx;
}

.timeline {
  position: relative;
  padding-left: 40rpx;
}

.timeline-item {
  position: relative;
  padding-bottom: 40rpx;
}

.timeline-item:last-child {
  padding-bottom: 0;
}

.timeline-dot {
  position: absolute;
  left: -40rpx;
  top: 8rpx;
  width: 20rpx;
  height: 20rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 50%;
  border: 4rpx solid #fff;
  box-shadow: 0 0 0 4rpx #f0f2f5;
  z-index: 2;
}

.timeline-line {
  position: absolute;
  left: -32rpx;
  top: 28rpx;
  bottom: -28rpx;
  width: 2rpx;
  background: linear-gradient(to bottom, #667eea 0%, #764ba2 100%);
  z-index: 1;
  opacity: 0.3;
}

.timeline-content {
  background: #fafbfc;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  border: 1rpx solid #f0f2f5;
}

.log-operation {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 8rpx;
}

.log-time {
  font-size: 24rpx;
  color: #999;
}

/* 安全区域 */
.bottom-safe-area {
  height: env(safe-area-inset-bottom);
  min-height: 40rpx;
}

/* 动画 */
.card {
  animation: fadeInUp 0.4s ease-out;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

button::after {
  border: none;
}
