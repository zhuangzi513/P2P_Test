<wxs module="goodsDetailPage">
module.exports = {
  url : function(item) {
    return '/pages/goods-details/index?id=' + item.id
  }
}
</wxs>

<view class="jd-main-container">
  <!-- Banker Info -->
  <view class="banker-info-card">
    <view class="banker-avatar-wrap">
      <image wx:if="{{bankerInfo.avatar}}" class="banker-avatar" src="{{bankerInfo.avatar}}" mode="aspectFill" />
      <view wx:else class="banker-avatar-placeholder">
        <text class="banker-avatar-text">{{bankerInfo.nick ? bankerInfo.nick.charAt(0) : '?'}}</text>
      </view>
    </view>
    <view class="banker-info-content">
      <view class="banker-nick">{{bankerInfo.nick || '未知'}}</view>
      <view class="banker-score">等级：{{bankerInfo.score || '--'}}</view>
    </view>
  </view>

  <!-- 服务费说明 -->
  <view class="tax-card">
    <view class="tax-card-header">
      <view class="tax-card-title-bar"></view>
      <text class="tax-card-title">服务费说明</text>
    </view>
    <view class="tax-card-body">
      <view class="tax-row">
        <text class="tax-row-label">卖家服务费</text>
        <text class="tax-row-value">{{bankerInfo.tax_ratio_to_saler ? bankerInfo.tax_ratio_to_saler + '%' : '未设置'}}</text>
        <view class="tax-row-divider"></view>
        <text class="tax-row-label">买家服务费</text>
        <text class="tax-row-value">{{bankerInfo.tax_ratio_to_buyer ? bankerInfo.tax_ratio_to_buyer + '%' : '未设置'}}</text>
      </view>
      <view class="tax-row">
        <text class="tax-row-label">固定起收价</text>
        <text class="tax-row-value">{{bankerInfo.fixed_tax_price ? '¥' + bankerInfo.fixed_tax_price : '未设置'}}</text>
        <view class="tax-row-divider"></view>
        <text class="tax-row-label">固定服务费</text>
        <text class="tax-row-value">{{bankerInfo.fixed_tax_value ? '¥' + bankerInfo.fixed_tax_value : '未设置'}}</text>
      </view>
    </view>
  </view>

  <!-- Tab Bar -->
  <view class="tab-bar">
    <view class="tab-item {{activeTab === 'recommend' ? 'tab-active' : ''}}" bindtap="switchTab" data-tab="recommend">推荐</view>
    <view class="tab-item {{activeTab === 'fixed' ? 'tab-active' : ''}}" bindtap="switchTab" data-tab="fixed">一口价</view>
    <view class="tab-item {{activeTab === 'negotiable' ? 'tab-active' : ''}}" bindtap="switchTab" data-tab="negotiable">可议价</view>
  </view>

  <!-- Goods Grid -->
  <view class="jd-goods-grid">
    <view class="jd-goods-card" wx:for="{{displayGoods}}" wx:key="id" bindtap="toDetailsTap" data-id="{{item.id}}">
      <view class="jd-goods-img-wrap">
        <image src="{{item.pic}}" mode="aspectFill" lazy-load="true" />
      </view>
      <view class="jd-goods-info">
        <view class="jd-goods-name">{{item.name}}</view>
        <view wx:if="{{item.characteristic}}" class="jd-goods-desc">{{item.characteristic}}</view>
        <view class="jd-goods-price-box">
          <view class="jd-goods-price">
            <text class="jd-price-symbol">¥</text>
            <text class="jd-price-num">{{item.price}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>
  <van-divider wx:if="{{ !loadingMoreHidden }}" custom-class="jd-end-divider" contentPosition="center">已经到底了</van-divider>
</view>
