<wxs module="goodsDetailPage">
module.exports = {
  url : function(item) {
    return '/pages/goods-details/index?id=' + item.id
  }
}
</wxs>

<view class="jd-main-container">
  <!-- Banker Info -->
  <view class="banker-info-card">
    <view class="banker-avatar-wrap">
      <image class="banker-avatar" src="{{bankerInfo.avatar}}" mode="aspectFill" />
    </view>
    <view class="banker-info-content">
      <view class="banker-nick">{{bankerInfo.nick || 'Unknown'}}</view>
      <view class="banker-score">Score: {{bankerInfo.score || '--'}}</view>
      <view class="banker-id">ID: {{bankerID}}</view>
    </view>
  </view>

  <!-- Tab Bar -->
  <view class="tab-bar">
    <view class="tab-item {{activeTab === 'recommend' ? 'tab-active' : ''}}" bindtap="switchTab" data-tab="recommend">Recommend</view>
    <view class="tab-item {{activeTab === 'fixed' ? 'tab-active' : ''}}" bindtap="switchTab" data-tab="fixed">Fixed Price</view>
    <view class="tab-item {{activeTab === 'negotiable' ? 'tab-active' : ''}}" bindtap="switchTab" data-tab="negotiable">Negotiable</view>
  </view>

  <!-- Goods Grid -->
  <view class="jd-goods-grid">
    <view class="jd-goods-card" wx:for="{{displayGoods}}" wx:key="id" bindtap="toDetailsTap" data-id="{{item.id}}">
      <view class="jd-goods-img-wrap">
        <image src="{{item.pic}}" mode="aspectFill" lazy-load="true" />
      </view>
      <view class="jd-goods-info">
        <view class="jd-goods-name">{{item.name}}</view>
        <view wx:if="{{item.characteristic}}" class="jd-goods-desc">{{item.characteristic}}</view>
        <view class="jd-goods-price-box">
          <view class="jd-goods-price">
            <text class="jd-price-symbol">¥</text>
            <text class="jd-price-num">{{item.price}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>
  <van-divider wx:if="{{ !loadingMoreHidden }}" custom-class="jd-end-divider" contentPosition="center">already to the bottom</van-divider>
</view>
