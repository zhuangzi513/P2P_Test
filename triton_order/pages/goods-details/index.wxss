page {
  background-color: #E4FFED;
}

page,
view,
image,
input,
textarea {
  display: block;
  box-sizing: border-box;
}

.container {
  background-color: #E4FFED;
  min-height: 100vh;
  padding-bottom: 120rpx;
}

.scroll-container {
  box-sizing: border-box;
  height: 100vh;
}

.goods-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #047504;
  text-align: center;
  padding: 30rpx 0;
  background-color: #fff;
}

.divider-icon-center {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 0;
  background-color: #fff;
}

.divider-icon-center .line {
  width: 120rpx;
  height: 1rpx;
  background-color: #C8E6C9;
}

.divider-icon-center icon {
  margin: 0 20rpx;
}

.swiper-container {
  width: 100%;
  position: relative;
  background-color: #000;
}

.swiper_box {
  width: 100%;
  height: 750rpx;
}

.slide-image {
  width: 100%;
  height: 750rpx;
}

.goods-info-card {
  background-color: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 80, 0, 0.1), 0 2rpx 8rpx rgba(0, 60, 0, 0.06);
}

.info-header {
  border-bottom: 1rpx solid #C8E6C9;
  padding-bottom: 20rpx;
  margin-bottom: 20rpx;
}

.info-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #026302;
}

.info-table {
  display: flex;
  flex-direction: column;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #E4FFED;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 28rpx;
  color: #047504;
  flex-shrink: 0;
}

.info-value {
  font-size: 28rpx;
  color: #333;
  text-align: right;
}

.info-value.price {
  font-size: 40rpx;
  font-weight: bold;
  color: #E4393C;
}

.fixed-price-tag {
  color: #E65100;
  font-weight: bold;
  font-size: 26rpx;
}

.description-content {
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
}

.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.grid-image {
  width: calc((100% - 32rpx) / 3);
  height: 220rpx;
  border-radius: 12rpx;
}

.video-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.video-item {
  width: 100%;
  height: 400rpx;
  border-radius: 12rpx;
}

/* ===== 底部按钮 - 绿色主题 ===== */
.van-goods-action {
  --goods-action-background-color: #E4FFED;
}

.van-goods-action-icon {
  --goods-action-icon-color: #047504;
  --goods-action-icon-text-color: #047504;
}

.van-goods-action-button {
  --goods-action-button-warning-color: #047504;
  --goods-action-button-height: 44px;
  --goods-action-button-line-height: 22px;
}

/* 按钮点击态 - 深绿色 */
.van-goods-action-button .van-button--warning {
  background: #047504;
}

.van-goods-action-button .van-button--warning:active {
  background: #026302 !important;
}

.van-goods-action-button .van-button--warning::after {
  border: none;
}

/* ===== 订单列表 ===== */
.orders-section {
  margin-bottom: 20rpx;
}

.orders-count {
  font-size: 24rpx;
  color: #999;
  font-weight: normal;
}

.orders-loading {
  text-align: center;
  padding: 40rpx 0;
  font-size: 26rpx;
  color: #999;
}

.orders-empty {
  text-align: center;
  padding: 60rpx 0;
  font-size: 26rpx;
  color: #999;
}

.orders-list {
  display: flex;
  flex-direction: column;
}

.order-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #E4FFED;
  position: relative;
}

.order-item:last-child {
  border-bottom: none;
}

.order-item:active {
  background: #f0faf0;
  margin: 0 -30rpx;
  padding-left: 30rpx;
  padding-right: 30rpx;
  border-radius: 8rpx;
}

.order-item-header {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.order-type-tag {
  display: inline-block;
  font-size: 22rpx;
  padding: 2rpx 16rpx;
  border-radius: 8rpx;
  margin-bottom: 8rpx;
  width: fit-content;
}

.tag-input {
  background: #E4FFED;
  color: #026302;
}

.tag-output {
  background: #FFF3E0;
  color: #E65100;
}

.order-id-text {
  font-size: 24rpx;
  color: #999;
}

.order-price-text {
  font-size: 28rpx;
  font-weight: bold;
  color: #E4393C;
}

.order-item-body {
  flex: 1;
  display: flex;
  justify-content: flex-end;
}

.order-info-col {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.order-time-text {
  font-size: 22rpx;
  color: #999;
}

.order-status-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.order-status-label {
  font-size: 24rpx;
  color: #999;
}

.order-status-value {
  font-size: 26rpx;
  font-weight: 500;
}

.status-done {
  color: #026302;
}

.status-cancelled {
  color: #999;
}

.status-pending {
  color: #E65100;
}

.order-item-arrow {
  font-size: 22rpx;
  color: #ccc;
  margin-left: 12rpx;
}
