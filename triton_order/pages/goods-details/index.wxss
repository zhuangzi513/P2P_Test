
page,
view,
image,
input,
textarea {
  display: block;
  box-sizing: border-box;
}

.container {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 120rpx;
}

.scroll-container {
  box-sizing: border-box;
  height: 100vh;
}

.goods-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  text-align: center;
  padding: 30rpx 0;
  background-color: #fff;
}

.divider-icon-center {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 0;
  background-color: #fff;
}

.divider-icon-center .line {
  width: 120rpx;
  height: 1rpx;
  background-color: #ddd;
}

.divider-icon-center icon {
  margin: 0 20rpx;
}

.swiper-container {
  width: 100%;
  position: relative;
  background-color: #000;
}

.swiper_box {
  width: 100%;
  height: 750rpx;
}

.slide-image {
  width: 100%;
  height: 750rpx;
}

.goods-info-card {
  background-color: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.info-header {
  border-bottom: 1rpx solid #eee;
  padding-bottom: 20rpx;
  margin-bottom: 20rpx;
}

.info-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.info-table {
  display: flex;
  flex-direction: column;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 28rpx;
  color: #666;
  flex-shrink: 0;
}

.info-value {
  font-size: 28rpx;
  color: #333;
  text-align: right;
}

.info-value.price {
  font-size: 40rpx;
  font-weight: bold;
  color: #ff6b6b;
}

.description-content {
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
}

.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.grid-image {
  width: calc((100% - 32rpx) / 3);
  height: 220rpx;
  border-radius: 12rpx;
}

.video-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.video-item {
  width: 100%;
  height: 400rpx;
  border-radius: 12rpx;
}
