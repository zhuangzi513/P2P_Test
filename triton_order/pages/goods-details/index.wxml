<view class="container">

  <scroll-view class="scroll-container" scroll-y="true">
    
    <view class="goods-title">商品详情</view>

    <view class="divider-icon-center">
      <view class="line"></view>
      <icon type="success" size="16" color="#07c160"></icon>
      <view class="line"></view>
    </view>

    <!-- 图片/视频轮播 -->
    <view class="swiper-container" id="swiper-container">
      <swiper class="swiper_box" indicator-dots="true" indicator-active-color="#fff" autoplay="true" circular>
        <swiper-item wx:if="{{goodsInfo.videoList && goodsInfo.videoList.length > 0}}">
          <video src="{{goodsInfo.videoList[0].url}}" autoplay="true" style='width:100%;height:100%;' object-fit="cover"></video>
        </swiper-item>
        <swiper-item wx:for="{{goodsInfo.imageList}}" wx:key="index">
          <image src="{{item.url}}" class="slide-image" mode="aspectFill" lazy-load="true" bindtap="previewImages" data-url="{{ item.url }}" />
        </swiper-item>
      </swiper>
    </view>

    <!-- 商品基本信息 -->
    <view class="goods-info-card">
      <view class="info-header">
        <text class="info-title">基本信息</text>
      </view>
      <view class="info-table">
        <view class="info-row">
          <text class="info-label">颜色</text>
          <text class="info-value">{{goodsInfo.color || '-'}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">尺寸</text>
          <text class="info-value">{{goodsInfo.sizeX || '-'}}{{goodsInfo.sizeY ? ' × ' + goodsInfo.sizeY : ''}}{{goodsInfo.sizeZ ? ' × ' + goodsInfo.sizeZ : ''}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">价格</text>
          <text class="info-value price">¥{{goodsInfo.price || '0'}}</text>
        </view>
      </view>
    </view>

    <!-- 商品描述 -->
    <view class="goods-info-card">
      <view class="info-header">
        <text class="info-title">商品描述</text>
      </view>
      <view class="description-content">
        <text>{{goodsInfo.description || '暂无描述'}}</text>
      </view>
    </view>

    <!-- 图片列表 -->
    <view class="goods-info-card" wx:if="{{goodsInfo.imageList && goodsInfo.imageList.length > 0}}">
      <view class="info-header">
        <text class="info-title">商品图片 ({{goodsInfo.imageList.length}})</text>
      </view>
      <view class="image-grid">
        <image wx:for="{{goodsInfo.imageList}}" wx:key="index" src="{{item.url}}" mode="aspectFill" lazy-load="true" 
          bindtap="previewImages" data-url="{{ item.url }}" class="grid-image" />
      </view>
    </view>

    <!-- 视频列表 -->
    <view class="goods-info-card" wx:if="{{goodsInfo.videoList && goodsInfo.videoList.length > 1}}">
      <view class="info-header">
        <text class="info-title">商品视频 ({{goodsInfo.videoList.length}})</text>
      </view>
      <view class="video-list">
        <video wx:for="{{goodsInfo.videoList}}" wx:key="index" src="{{item.url}}" class="video-item" object-fit="cover" />
      </view>
    </view>

    <!-- 订单列表 -->
    <view class="goods-info-card orders-section">
      <view class="info-header">
        <text class="info-title">商品订单</text>
        <text class="orders-count" wx:if="{{orderList.length > 0}}">{{orderList.length}}条</text>
      </view>
      <view class="orders-loading" wx:if="{{orderLoading}}">
        <text>加载中...</text>
      </view>
      <view class="orders-empty" wx:elif="{{orderList.length === 0}}">
        <text>暂无订单记录</text>
      </view>
      <view class="orders-list" wx:else>
        <view class="order-item" wx:for="{{orderList}}" wx:key="order_id" bindtap="goOrderDetail" data-orderid="{{item.order_id}}" data-ordertype="{{item.order_type}}">
          <view class="order-item-header">
            <text class="order-type-tag {{item.order_type === 0 ? 'tag-input' : 'tag-output'}}">{{item.orderTypeLabel}}</text>
            <text class="order-id-text">订单号: {{item.order_id}}</text>
          </view>
          <view class="order-item-body">
            <view class="order-status-row">
              <text class="order-status-label">状态</text>
              <text class="order-status-value {{item.status === 8 || item.status === 5 ? 'status-done' : item.status === 9 || item.status === 6 || item.status === 12 || item.status === 9 ? 'status-cancelled' : 'status-pending'}}">{{item.statusText}}</text>
            </view>
          </view>
          <view class="order-item-arrow">▶</view>
        </view>
      </view>
    </view>

  </scroll-view>
  
  <van-goods-action>
    <van-goods-action-icon icon="{{faved?'like':'like-o'}}" text="收藏" bind:click="addFav" />
    <van-goods-action-button text="{{goodsInfo.fixedprice ? '立即购买' : '出价'}}" type="warning" bind:click="tobuy" />
  </van-goods-action>
</view>
